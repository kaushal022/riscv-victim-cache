// =============================================
// Load-Use Hazard with Cache Miss Test
// Tests that load-use stalls and cache stalls
// interact correctly (double-stall scenario)
// =============================================
@00000000
// x1 = 100, store at address 0
06400093    // addi x1, x0, 100
00102023    // sw x1, 0(x0)

// x1 = 200, store at address 4
0C800093    // addi x1, x0, 200
00102223    // sw x1, 4(x0)

// Load x3 from addr 0 (cache cold miss → stall)
00002183    // lw x3, 0(x0)         -> x3 = 100

// LOAD-USE: immediately use x3 (both load-use stall AND possible cache stall)
00318193    // addi x3, x3, 3       -> x3 = 103 (tests load-use forwarding)

// Load x4 from addr 4 (should be cache hit if same block)
00402203    // lw x4, 4(x0)         -> x4 = 200

// Verify forwarding works with cache
00420213    // addi x4, x4, 4       -> x4 = 204

// Store x3 result to addr 8
00302423    // sw x3, 8(x0)

// Load back and verify
00802283    // lw x5, 8(x0)         -> x5 = 103

// Halt
0000006F    // jal x0, 0
